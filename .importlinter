[importlinter]
root_package = ragline
include_external_packages = True

# ragline.engine is intentionally excluded from source_modules:
# it is the ONLY module permitted to import langgraph / langchain_core.
# If you add ragline.engine to source_modules below, you will break the architecture.
[importlinter:contract:engine-only-langgraph]
name = engine/ is the only module allowed to import langgraph
type = forbidden
source_modules =
    ragline.api
    ragline.config
    ragline.registry
    ragline.handlers
    ragline.providers
    ragline.server
    ragline.testing
forbidden_modules =
    langgraph
    langchain_core
# ragline.api.rag is the top-level public API that must bridge into the engine layer.
# We allow the single crossing ragline.api.rag -> ragline.engine.graph so that
# the forbidden checker does not trace through this edge into langgraph/langchain_core.
ignore_imports =
    ragline.api.rag -> ragline.engine.graph

[importlinter:contract:testing-no-engine]
name = ragline.testing must not import ragline.engine
type = forbidden
source_modules =
    ragline.testing
forbidden_modules =
    ragline.engine
